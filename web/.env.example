# 학생용 웹이 바라볼 백엔드 주소.
# 로컬 개발: uv run songsim-api 로 띄운 뒤 http://127.0.0.1:8000
# 배포: https://songsim-public-api.onrender.com
SONGSIM_API_BASE=http://127.0.0.1:8000

# 잠든 백엔드가 페이지를 붙잡지 못하게 하는 요청 제한시간(ms).
SONGSIM_API_TIMEOUT_MS=5000

# 장소 상세 미니 지도. Kakao Developers의 JavaScript 키를 사용하고,
# http://localhost:3000 을 JavaScript SDK 도메인으로 등록한다.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
